# SafeChat AI backend environment example

# SQLite is the current default in code. If database configuration is later
# moved to environment-driven setup, keep this file aligned with that change.
# DATABASE_URL=sqlite:///./safechat.db

# Bridge control API used by backend/api/whatsapp.py
WHATSAPP_BRIDGE_CONTROL_URL=http://127.0.0.1:3011

# Retention counts for stored bridge operational history
WHATSAPP_BRIDGE_EVENT_RETENTION=1000
WHATSAPP_BRIDGE_STATE_SNAPSHOT_RETENTION=1000

# Demo-safe single-account WhatsApp bridge mode.
# Keeps one shared bridge session and can auto-ingest incoming messages even
# when no monitored contacts are configured yet.
SAFECHAT_WHATSAPP_SINGLE_ACCOUNT_MODE=1
SAFECHAT_WHATSAPP_DEMO_SESSION_KEY=safechat-demo
SAFECHAT_WHATSAPP_AUTO_FORWARD_ALL=1
# SAFECHAT_WHATSAPP_DEMO_OWNER_EMAIL=admin@safechat.local

# Optional model override for lightweight local runs and tests
# SAFECHAT_DISABLE_MODELS=1
# Optional local custom classifier path. Relative paths resolve from repo root.
# Defaults to `classifier/`, then falls back to `best_model/` if present.
# SAFECHAT_CUSTOM_MODEL_PATH=classifier

# Local default admin account seeded on backend startup
SAFECHAT_CREATE_DEFAULT_ADMIN=1
SAFECHAT_DEFAULT_ADMIN_USERNAME=admin
SAFECHAT_DEFAULT_ADMIN_EMAIL=admin@safechat.local
SAFECHAT_DEFAULT_ADMIN_PASSWORD=Admin123!
SAFECHAT_DEFAULT_ADMIN_NAME=SafeChat Admin

# OCR provider for screenshot analysis:
# - easyocr: local EasyOCR provider
# - tesseract: force local Tesseract OCR
# - google: require Google Cloud Vision
# - ocrspace: require OCR.space API
# - auto: prefer EasyOCR, then OCR.space, then Google Cloud Vision, then Tesseract
SAFECHAT_OCR_PROVIDER=easyocr

# EasyOCR settings
# EASYOCR_LANG_LIST=en
# EASYOCR_USE_GPU=0

# OCR.space API settings
# Register for a free API key at https://ocr.space/ocrapi
# OCR.space free tier currently documents 25,000 requests/month and
# 500 requests/day per IP.
# OCR_SPACE_API_KEY=your-free-ocr-space-key
# OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
# OCR_SPACE_LANGUAGE=eng
# OCR_SPACE_ENGINE=2
# OCR_SPACE_TIMEOUT_SECONDS=60

# Google Cloud Vision uses Application Default Credentials.
# Point this to your downloaded Google service-account JSON file when using
# local development on Windows.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-vision-service-account.json
