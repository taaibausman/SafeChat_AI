# SafeChat AI backend environment example

# SQLite is the current default in code. If database configuration is later
# moved to environment-driven setup, keep this file aligned with that change.
# DATABASE_URL=sqlite:///./safechat.db

# Bridge control API used by backend/api/whatsapp.py
WHATSAPP_BRIDGE_CONTROL_URL=http://127.0.0.1:3011

# Retention counts for stored bridge operational history
WHATSAPP_BRIDGE_EVENT_RETENTION=1000
WHATSAPP_BRIDGE_STATE_SNAPSHOT_RETENTION=1000

# Optional model override for lightweight local runs and tests
# SAFECHAT_DISABLE_MODELS=1
